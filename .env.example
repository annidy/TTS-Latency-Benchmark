# Copy to .env.local. Fill only the providers you intend to run.
# Never commit the populated .env.local file.

# Label recorded in every sample. Use a real location for regional comparisons.
TTFA_CLIENT_REGION=local

# BreezeBlue: Breeze TTS 2
BREEZEBLUE_API_KEY=
BREEZEBLUE_VOICE_ID=

# ElevenLabs: Flash v2.5 and v3
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Fish Audio: S2.1 Pro
FISH_AUDIO_API_KEY=
FISH_AUDIO_VOICE_ID=

# Cartesia: Sonic 3.5
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# Inworld: TTS-2
INWORLD_API_KEY=
INWORLD_VOICE_ID=

# xAI TTS
XAI_API_KEY=
XAI_VOICE_ID=

# Async: Flash 1.5
ASYNC_API_KEY=
ASYNC_VOICE_ID=

# Speechify: Simba 3.2
SPEECHIFY_API_KEY=
SPEECHIFY_VOICE_ID=
